# Stripe API Keys
# テスト環境では sk_test_xxx を使用
# 本番環境では sk_live_xxx を使用（絶対にコミットしない）
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/stripe_payment?schema=public"

# Server
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=info
